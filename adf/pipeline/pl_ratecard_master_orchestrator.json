{
	"name": "pl_ratecard_master_orchestrator",
	"properties": {
		"description": "Master Pipeline orchestrating OLTP extraction, ADLS Bronze staging, and Databricks Silver/Gold execution with parameterized 3-level catalog namespaces",
		"activities": [
			{
				"name": "act_copy_oltp_ratecard_to_bronze",
				"description": "Reads delta changes from OLTP and writes directly to ADLS Gen2 Bronze parquet staging",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "PostgreSqlSource",
						"query": {
							"value": "SELECT pricing_rule_id, customer_id, part_number, subscription_id, subscription_line_id, date_start, date_end, to_json(tier_pricing_rules) AS tier_pricing_rules, created_at, updated_at FROM billing_oltp.subscription_ratecard_rules WHERE updated_at > '@{pipeline().parameters.p_watermark_timestamp}'",
							"type": "Expression"
						}
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ds_oltp_ratecard_source",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ds_adls_bronze_ratecard_sink",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "act_silver_transform",
				"description": "Parses nested struct arrays, explodes tiers, calculates SHA-256 surrogate hashes, and persists to {catalog}.silver",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "act_copy_oltp_ratecard_to_bronze",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Users/sk03167@gmail.com/work_experience_pipeline_code/databricks/notebooks/02_silver_transform",
					"baseParameters": {
						"execution_date": {
							"value": "@utcnow()",
							"type": "Expression"
						},
						"env": {
							"value": "@pipeline().parameters.p_environment",
							"type": "Expression"
						},
						"catalog_name": {
							"value": "@pipeline().parameters.p_catalog_name",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_azure_databricks",
					"type": "LinkedServiceReference",
					"parameters": {
						"DATABRICKS_URL": "https://adb-7405615524664227.7.azuredatabricks.net"
					}
				}
			},
			{
				"name": "act_gold_star_schema_load",
				"description": "Performs conformed dimension surrogate key lookups (-1 unknown fallback), builds Gold Star Schema, and commits ACID Delta watermark",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "act_silver_transform",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Users/sk03167@gmail.com/work_experience_pipeline_code/databricks/notebooks/03_gold_star_schema_load",
					"baseParameters": {
						"execution_date": {
							"value": "@utcnow()",
							"type": "Expression"
						},
						"env": {
							"value": "@pipeline().parameters.p_environment",
							"type": "Expression"
						},
						"catalog_name": {
							"value": "@pipeline().parameters.p_catalog_name",
							"type": "Expression"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "ls_azure_databricks",
					"type": "LinkedServiceReference",
					"parameters": {
						"DATABRICKS_URL": "https://adb-7405615524664227.7.azuredatabricks.net"
					}
				}
			}
		],
		"parameters": {
			"p_watermark_timestamp": {
				"type": "string",
				"defaultValue": "1970-01-01 00:00:00"
			},
			"p_environment": {
				"type": "string",
				"defaultValue": "dev"
			},
			"p_catalog_name": {
				"type": "string",
				"defaultValue": "adb_ratecard_dev_001"
			}
		},
		"annotations": []
	}
}

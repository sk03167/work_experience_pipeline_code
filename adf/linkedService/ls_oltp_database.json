{
	"name": "ls_oltp_database",
	"properties": {
		"description": "Secure connection to Neon PostgreSQL billing_oltp database using Azure Key Vault",
		"parameters": {
			"DB_SERVER": {
				"type": "string",
				"defaultValue": "ep-bold-wave-aoq3m6gy-pooler.c-2.ap-southeast-1.aws.neon.tech"
			},
			"DB_NAME": {
				"type": "string",
				"defaultValue": "finguard-db"
			},
			"DB_USER": {
				"type": "string",
				"defaultValue": "finguard-db_owner"
			}
		},
		"annotations": [],
		"type": "PostgreSql",
		"typeProperties": {
			"connectionString": "Host=@{linkedService().DB_SERVER};Port=5432;Database=@{linkedService().DB_NAME};UID=@{linkedService().DB_USER};EncryptionMethod=0",
			"password": {
				"type": "AzureKeyVaultSecret",
				"store": {
					"referenceName": "ls_azure_key_vault",
					"type": "LinkedServiceReference"
				},
				"secretName": "oltp-db-password"
			},
			"port": 5432,
			"sslMode": 1
		}
	},
	"type": "Microsoft.DataFactory/factories/linkedservices"
}

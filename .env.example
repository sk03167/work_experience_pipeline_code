# Neon Postgres Connection Configuration
# Paste your Neon connection string details below:
# Example: postgresql://username:password@ep-cool-frost-123456.us-east-2.neon.tech/neondb?sslmode=require

NEON_DB_USER=neondb_owner
NEON_DB_PASSWORD=your_password_here
NEON_DB_HOST=ep-example-subdomain.us-east-2.neon.tech
NEON_DB_PORT=5432
NEON_DB_NAME=neondb
NEON_SSL_MODE=require

# Full URI alternative:
# NEON_DATABASE_URL=postgresql://neondb_owner:your_password_here@ep-example-subdomain.us-east-2.neon.tech/neondb?sslmode=require

# Lakehouse Storage Emulation (Local or ADLS)
STORAGE_BASE_PATH=./data/lakehouse
BRONZE_PATH=./data/lakehouse/bronze
SILVER_PATH=./data/lakehouse/silver
GOLD_PATH=./data/lakehouse/gold

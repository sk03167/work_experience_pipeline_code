                         "seed":  45336,
                         "version":  1,
                         "originalText":  "C. Workflow Dynamic System Values\n\nReferenced in Databricks Task parameters:\n{{job.id}}               - Databricks Job ID\n{{job.run_id}}           - Unique Run instance ID\n{{task.name}}             - Active task name\n{{task.execution_count}} - Current retry count\n{{task.start_time}}       - ISO start timestamp\n{{input}}                 - Trigger payload from Webhook/Event",
                         "x":  1115,
                         "fontFamily":  3,
                         "verticalAlign":  "top",
                         "updated":  1,
                         "opacity":  100,
                         "text":  "C. Workflow Dynamic System Values\n\nReferenced in Databricks Task parameters:\n{{job.id}}               - Databricks Job ID\n{{job.run_id}}           - Unique Run instance ID\n{{task.name}}             - Active task name\n{{task.execution_count}} - Current retry count\n{{task.start_time}}       - ISO start timestamp\n{{input}}                 - Trigger payload from Webhook/Event",

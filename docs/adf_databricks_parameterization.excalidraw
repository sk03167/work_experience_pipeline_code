                         "version":  1,
                         "originalText":  "A. Notebook Activity: \u0027baseParameters\u0027\n\nADF Pipeline JSON Definition:\n\"typeProperties\": {\n  \"notebookPath\": \"/Repos/dev/02_silver_transform\",\n  \"baseParameters\": {\n    \"p_execution_date\": \"@{pipeline().TriggerTime}\",\n    \"p_env\": \"@{pipeline().parameters.p_environment}\",\n    \"p_watermark\": \"@{activity(\u0027act_lookup\u0027).output.val}\"\n  }\n}\n\n-\u003e Injected directly into Databricks widget namespace!",
                         "x":  585,
                         "fontFamily":  3,
                         "verticalAlign":  "top",
                         "updated":  1,
                         "opacity":  100,
                         "text":  "A. Notebook Activity: \u0027baseParameters\u0027\n\nADF Pipeline JSON Definition:\n\"typeProperties\": {\n  \"notebookPath\": \"/Repos/dev/02_silver_transform\",\n  \"baseParameters\": {\n    \"p_execution_date\": \"@{pipeline().TriggerTime}\",\n    \"p_env\": \"@{pipeline().parameters.p_environment}\",\n    \"p_watermark\": \"@{activity(\u0027act_lookup\u0027).output.val}\"\n  }\n}\n\n-\u003e Injected directly into Databricks widget namespace!",

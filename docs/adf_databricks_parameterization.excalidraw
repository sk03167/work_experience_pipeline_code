                         "seed":  25111,
                         "version":  1,
                         "originalText":  "B. Ingesting in Databricks (PySpark)\n\n# 1. Define widget with safe fallback:\ndbutils.widgets.text(\"p_execution_date\", \"\", \"Exec Date\")\ndbutils.widgets.text(\"p_env\", \"dev\", \"Environment\")\n\n# 2. Retrieve dynamic value:\nexec_date = dbutils.widgets.get(\"p_execution_date\")\nenv = dbutils.widgets.get(\"p_env\")\n\nprint(f\"Running pipeline for {env} at {exec_date}\")",
                         "x":  585,

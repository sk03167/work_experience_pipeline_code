                         "seed":  79859,
                         "version":  1,
                         "originalText":  "D. Spark Conf, SQL Variables \u0026 OS Env\n\n1. Spark Session Conf:\n   spark.conf.set(\u0027app.watermark\u0027, \u00272026-10-26\u0027)\n   spark.conf.get(\u0027app.watermark\u0027)\n\n2. SQL Variable Interpolation:\n   SET custom.batch_id = \u0027B_001\u0027;\n   SELECT * FROM logs WHERE batch = \u0027\u0027;\n\n3. Cluster Environment Variables:\n   os.getenv(\u0027ENVIRONMENT\u0027)  |  os.getenv(\u0027DATABRICKS_RUNTIME_VERSION\u0027)",
                         "x":  1115,
                         "fontFamily":  3,
                         "verticalAlign":  "top",
                         "updated":  1,
                         "opacity":  100,
                         "text":  "D. Spark Conf, SQL Variables \u0026 OS Env\n\n1. Spark Session Conf:\n   spark.conf.set(\u0027app.watermark\u0027, \u00272026-10-26\u0027)\n   spark.conf.get(\u0027app.watermark\u0027)\n\n2. SQL Variable Interpolation:\n   SET custom.batch_id = \u0027B_001\u0027;\n   SELECT * FROM logs WHERE batch = \u0027\u0027;\n\n3. Cluster Environment Variables:\n   os.getenv(\u0027ENVIRONMENT\u0027)  |  os.getenv(\u0027DATABRICKS_RUNTIME_VERSION\u0027)",
